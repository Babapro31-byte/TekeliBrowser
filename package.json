{
  "name": "tekeli-browser",
  "version": "4.0.0-dev.0",
  "description": "TekeliBrowser — private, fast desktop browser",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "browser",
    "glassmorphism",
    "modern"
  ],
  "author": "TekeliBrowser",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@ghostery/adblocker": "^2.18.2",
    "@ghostery/adblocker-electron-preload": "^2.18.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.575.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tldts": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.tekeli.browser",
    "productName": "TekeliBrowser",
    "icon": "public/logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Babapro31-byte",
      "repo": "TekeliBrowser",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
